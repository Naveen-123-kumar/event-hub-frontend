{
  "info": {
    "name": "EventHub",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:5000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{base}}/api/health" }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"naveen@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{base}}/api/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"naveen@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{base}}/api/auth/login"
      }
    },
    {
      "name": "List events",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base}}/api/events?page=1&limit=9"
      }
    },
    {
      "name": "Create booking",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"EVENT_ID\",\n  \"items\": [{ \"ticketId\": \"TICKET_ID\", \"quantity\": 1 }]\n}"
        },
        "url": "{{base}}/api/bookings"
      }
    },
    {
      "name": "My bookings",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base}}/api/bookings/me"
      }
    },
    {
      "name": "Create payment (if mounted)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "pay_demo_1" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookingId\": \"BOOKING_ID\"\n}"
        },
        "url": "{{base}}/api/payments/create"
      }
    }
  ]
}
